# 1. Lancer TaskMaster en mode foreground (shell interactif)
./taskmaster start
# -> Shell interactif visible
# -> Vérifier que tous les programmes autostart=true démarrent

# 2. Vérifier le status des programmes
taskmaster> status
# -> Vérifier RUNNING / STOPPED
# -> Vérifier retries, uptime pour chaque programme

# 3. Stop d’un programme spécifique
taskmaster> stop <program_name>
# -> Vérifier que le programme passe à STOPPED
# -> Vérifier logs pour l’arrêt

# 4. Start d’un programme spécifique
taskmaster> start <program_name>
# -> Vérifier que le programme passe à RUNNING
# -> Vérifier logs pour le démarrage

# 5. Restart d’un programme
taskmaster> restart <program_name>
# -> Vérifier que le programme s’arrête puis redémarre correctement
# -> Vérifier logs pour stop + start

# 6. Reload de la configuration YAML via SIGHUP
kill -SIGHUP <taskmaster_pid>
# -> Vérifier logs: 
#    "SIGHUP received, reloading configuration..."
#    "Reloading configuration..."
#    "Config changed for '<program>'"
# -> Vérifier que seuls les programmes modifiés sont redémarrés

# 7. Kill d’un programme (crash)
kill -9 <program_pid>
# -> Vérifier que l’autorestart fonctionne si défini
# -> Vérifier logs pour restart automatique
# -> Vérifier status pour RUNNING correct après restart

# 8. Stop du daemon foreground
taskmaster> stop all
# -> Vérifier que tous les programmes STOPPED
# -> Vérifier logs pour arrêts propres

