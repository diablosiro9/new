2 - Client CLI
# Interroger le daemon depuis le client CLI
python3 bonus/client.py status
# -> Vérifier que le status reflète l’état réel des programmes
python3 bonus/client.py stop <program_name>
# -> Vérifier l’arrêt via daemon

3 - Webhook sur Daemon
#Avant lancement Daemon
python3 bonus/webhook_browser.py 
# Configurer un webhook pour notification sur reload/stop/start
# -> Modifier YAML pour ajouter webhook
kill -SIGHUP <daemon_pid>
# -> Vérifier que le webhook reçoit les notifications

4 - Attach 
# Attacher un programme au daemon
python3 bonus/client.py attach <program_name>
# -> Vérifier que le shell montre les logs live du programme

5 - Detach 
# Détacher au daemon
python3 /bonus/client detach
# -> Vérifier que le shell revient au prompt normal, daemon continue 

6 - De Escalation User
# Créer un utilisateur de test
sudo adduser testuser
# -> Suivre les prompts pour mot de passe et informations

# Vérifier droits de l’utilisateur sur le daemon
su - testuser
python3 bonus/client.py stop <program_restricted>
# -> Normalement: ERR permission denied

# Escalation / sudo pour arrêter un programme restreint
sudo python3 bonus/client.py stop <program_restricted>
